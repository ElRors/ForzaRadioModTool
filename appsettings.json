{
  "Paths": {
    "MediaPath": "media",
    "AudioPath": "Audio",
    "FModBanksPath": "FMODBanks",
    "ToolsPath": "Tools",
    "FmodBankToolsPath": "Tools/FmodBankTools",
    "BackupPath": "Tools/FmodBankTools/bank",
    "WavPath": "Tools/FmodBankTools/wav",
    "FsbPath": "Tools/FmodBankTools/fsb"
  },
  "Audio": {
    "DefaultVolumeDb": -13.0,
    "SampleRate": 44100,
    "Channels": 2,
    "SupportedFormats": ["*.wav", "*.mp3", "*.ogg", "*.flac", "*.aac", "*.m4a", "*.wma"]
  },
  "UI": {
    "DefaultLanguage": "EN",
    "SupportedLanguages": ["EN", "MX", "BR", "DE", "FR"],
    "MinWindowWidth": 1000,
    "MinWindowHeight": 600,
    "ShowTooltips": true,
    "RememberWindowSize": true
  },
  "Logging": {
    "LogLevel": "Information",
    "LogFilePath": "logs/ForzaRadioModTool-.log",
    "EnableFileLogging": true,
    "EnableConsoleLogging": false,
    "MaxLogFiles": 10,
    "LogFilePattern": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
  }
}